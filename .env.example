# =====================================================================
# Maison Oleria — Environment Variables Reference
# Copy this file to .env.local (dev) and configure the same keys in
# Vercel Project Settings > Environment Variables (production/preview).
# =====================================================================

# ---------------------------------------------------------------------
# DATABASE (Phase 1) — PostgreSQL via Supabase or Neon + Prisma
# ---------------------------------------------------------------------
# Pooled connection string (used at runtime by the app)
DATABASE_URL="postgresql://user:password@host:5432/dbname?pgbouncer=true"
# Direct (non-pooled) connection string, required by Prisma Migrate
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# ---------------------------------------------------------------------
# STRIPE (payments)
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_live_or_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_or_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."   # REQUIRED in production, webhook rejects unsigned events otherwise

# ---------------------------------------------------------------------
# SITE / APP
# ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://maison-oleria.com"
NODE_ENV="production"

# ---------------------------------------------------------------------
# STORYBLOK (CMS)
# ---------------------------------------------------------------------
NEXT_PUBLIC_STORYBLOK_TOKEN="..."
STORYBLOK_PREVIEW_TOKEN="..."

# ---------------------------------------------------------------------
# EMAIL (Resend)
# ---------------------------------------------------------------------
RESEND_API_KEY="re_..."

# ---------------------------------------------------------------------
# MAILCHIMP (optional newsletter sync)
# ---------------------------------------------------------------------
MAILCHIMP_API_KEY=""
MAILCHIMP_AUDIENCE_ID=""
MAILCHIMP_SERVER="us1"

# ---------------------------------------------------------------------
# ADMIN AUTH
# ---------------------------------------------------------------------
ADMIN_EMAIL="admin@maison-oleria.com"
ADMIN_PASSWORD_HASH="$2a$10$..."   # bcrypt hash, never store plaintext
SESSION_SECRET="change-me-to-a-long-random-string"

# ---------------------------------------------------------------------
# PHASE 3 — ANTI-SPAM / ANTI-BOT (Captcha abstraction)
# CAPTCHA_PROVIDER: "turnstile" | "recaptcha" | "none"
# ---------------------------------------------------------------------
CAPTCHA_PROVIDER="none"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# ---------------------------------------------------------------------
# PHASE 4 — RGPD / CONSENT MODE V2
# ---------------------------------------------------------------------
NEXT_PUBLIC_COOKIE_CONSENT_REQUIRED="true"
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL="privacy@maison-oleria.com"

# ---------------------------------------------------------------------
# PHASE 5 — MODULAR ADVERTISING (each independently enable/disable)
# ---------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_ADS_ENABLED="false"
NEXT_PUBLIC_GOOGLE_ADS_ID=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

NEXT_PUBLIC_META_ADS_ENABLED="false"
NEXT_PUBLIC_META_PIXEL_ID=""

NEXT_PUBLIC_TIKTOK_ADS_ENABLED="false"
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""

NEXT_PUBLIC_LINKEDIN_ADS_ENABLED="false"
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=""

NEXT_PUBLIC_MICROSOFT_ADS_ENABLED="false"
NEXT_PUBLIC_MICROSOFT_UET_TAG_ID=""

# ---------------------------------------------------------------------
# PHASE 7 — ADMIN AI (never exposed to visitors)
# AI_PROVIDER: "openai" | "gemini" | "claude" | "nanobanana" | "openrouter"
# ---------------------------------------------------------------------
AI_PROVIDER="openai"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
NANOBANANA_API_KEY=""
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"

# ---------------------------------------------------------------------
# PHASE 8 — MONITORING
# ---------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
